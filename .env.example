# Server Port (Optional)
PORT=3000

# Supabase Configurations
# Dapatkan URL dari Supabase Project Settings -> API -> Project URL
SUPABASE_URL=your_supabase_project_url

# Dapatkan Anon/Public Key dari Supabase Project Settings -> API -> Project API Keys (anon public)
SUPABASE_KEY=your_supabase_anon_public_key

# Gemini AI API Key (Diperlukan untuk fitur AI SISIL)
# Dapatkan dari Google AI Studio
GEMINI_API_KEY=your_gemini_api_key
